# Letterhead paper of Taller Nogal: the PDF that the documentation's documents use as a background
# (reference/components/image.md). Page 1 is the one for the first sheet of a letter, with the full
# letterhead; page 2, the one for the following sheets, with the small logo. Both carry the legal footer.
# It is converted with tools/ExamplePdfs.java into resources/images/examples/letterhead/letterhead.pdf.
Document (dev.stxt.pdf):
	Language: es
	Title: Papel de carta de Taller Nogal
	Page:
		Paper: A4
		Margin: 0
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 8
				Line height: 12
				Color: #6B5B4E
		For style: legal
			Box:
				Padding: 6 0 0 0
				Border: 0.5 0 0 0
				Border color: #B5651D
			Typography:
				Size: 7
				Align: center
	Section:
		Id: first
		Overlay:
			Offset: 40 72 auto 72
			Stack:
				Horizontal: between
				Vertical: end
				Box:
					Padding: 0 0 12 0
					Border: 0 0 1.5 0
					Border color: #3B2A1E
				Item:
					Image: examples/brand/nogal.svg
						Alt: Nogal, taller de mobiliario
						Box:
							Width: 150
				Item:
					Block:
						Text: Carrer de la Farga, 14 · 17800 Olot
							Typography:
								Align: right
						Text: 972 00 11 22 · tallernogal.example
							Typography:
								Align: right
		Overlay:
			Offset: auto 72 28 72
			Text: Taller Nogal S.L. · CIF B-17482930 · Inscrita en el Registro Mercantil de Girona, tomo 3120, folio 44
				Style: legal
	Section:
		Id: next
		Overlay:
			Offset: 30 72 auto auto
			Image: examples/brand/nogal.svg
				Alt: Nogal, taller de mobiliario
				Box:
					Width: 80
		Overlay:
			Offset: auto 72 28 72
			Text: Taller Nogal S.L. · CIF B-17482930 · Inscrita en el Registro Mercantil de Girona, tomo 3120, folio 44
				Style: legal
