# Horario escolar semanal en una página A4 apaisada (Paper: A4 y Orientation: landscape, 842 × 595): una tabla con las celdas
# separadas por un Gap, una celda de hora a la izquierda, asignaturas con su color y franjas de
# recreo y comedor que ocupan los cinco días con Span, una leyenda en un Flex con salto de línea
# y unas notas en Markdown. Cada color es una clase de styles.stxt.
Document (dev.stxt.boxes):
	Media:
		Paper: A4
		Orientation: landscape
		Margin: 40 46 46 46
	Title: Horario de 2.º B · Curso 2025-26
	Language: es
	Fixed:
		Id: footer
		Offset: auto 0 -30 0
		Flex:
			Main axis: between
			Item:
				Text: CEIP Pla de les Eres · Olot
			Item:
				Text: Horario válido del 8 de septiembre de 2025 al 19 de junio de 2026
	Flex:
		Id: masthead
		Cross axis: center
		Gap: 14
		Box:
			Margin: 0 0 16 0
		Item:
			Image: examples/planner/icon.png
				Alt: Icono de un calendario
				Box:
					Width: 50
		Item:
			Grow: 1
			Block:
				Heading 1:
					Text: Horario de 2.º B
				Text: Curso 2025–26 · Tutora: Marta Ferrer
					Typography:
						Size: 11
						Color: #55655D
		Item:
			Block:
				Text: Entrada 9:00 · Salida 16:00
					Typography:
						Weight: bold
						Align: right
				Text: Recreo de 11:00 a 11:30
					Typography:
						Size: 8.5
						Align: right
						Color: #55655D
	Table:
		Id: timetable
		Columns: 92 repeat(5, 1fr)
		Gap: 3
		Box:
			Margin: 0 0 14 0
		Head:
			Row:
				Cell:
				Cell: Lunes
				Cell: Martes
				Cell: Miércoles
				Cell: Jueves
				Cell: Viernes
		Body:
			Row:
				Cell: 9:00 – 10:00
					Class: hour
				Cell: Matemáticas
					Class: slot math
				Cell: Lengua
					Class: slot lang
				Cell: Inglés
					Class: slot eng
				Cell: Matemáticas
					Class: slot math
				Cell: Ciencias
					Class: slot sci
			Row:
				Cell: 10:00 – 11:00
					Class: hour
				Cell: Lengua
					Class: slot lang
				Cell: Matemáticas
					Class: slot math
				Cell: Ciencias
					Class: slot sci
				Cell: Lengua
					Class: slot lang
				Cell: Inglés
					Class: slot eng
			Row:
				Cell:
					Class: hour
				Cell: Recreo · 11:00 – 11:30
					Span: 1 5
					Class: break
			Row:
				Cell: 11:30 – 12:30
					Class: hour
				Cell: Ciencias
					Class: slot sci
				Cell: Música
					Class: slot music
				Cell: Matemáticas
					Class: slot math
				Cell: Plástica
					Class: slot art
				Cell: Lengua
					Class: slot lang
			Row:
				Cell: 12:30 – 13:30
					Class: hour
				Cell: Educación física
					Class: slot pe
				Cell: Inglés
					Class: slot eng
				Cell: Lengua
					Class: slot lang
				Cell: Ciencias
					Class: slot sci
				Cell: Matemáticas
					Class: slot math
			Row:
				Cell:
					Class: hour
				Cell: Comedor y patio · 13:30 – 15:00
					Span: 1 5
					Class: break
			Row:
				Cell: 15:00 – 16:00
					Class: hour
				Cell: Taller
					Class: slot lab
				Cell: Educación física
					Class: slot pe
				Cell: Tutoría
					Class: slot tutor
				Cell: Taller
					Class: slot lab
				Cell: Proyecto
					Class: slot proj
