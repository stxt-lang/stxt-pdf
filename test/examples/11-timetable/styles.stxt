# Estilos del ejemplo «timetable»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9.5
			Line height: 13
			Color: #1F2B24
	Element: Heading 1
		Typography:
			Size: 24
			Line height: 28
			Weight: bold
			Color: #1B4332
	Element: List
		Box:
			Padding: 0 0 0 14
	Element: Cell
		Box:
			Padding: 14 6
			Radius: 5
		Typography:
			Align: center
	Element: Fixed
		Typography:
			Size: 7.5
			Color: #6B7A72
	Element: Head cell
		Typography:
			Weight: bold
			Size: 9
			Color: #FFFFFF
		Box:
			Background: #2D6A4F
	For class: hour
		Typography:
			Weight: bold
			Size: 8.5
			Color: #2D6A4F
			Align: right
		Box:
			Padding: 14 8 14 0
	For class: break
		Typography:
			Size: 8.5
			Style: italic
			Color: #55655D
		Box:
			Background: #EEF1EF
			Padding: 4 6
	For class: slot
		Typography:
			Weight: bold
	For class: math
		Box:
			Background: #D6E4F7
		Typography:
			Color: #1D3B6B
	For class: lang
		Box:
			Background: #F8D9D6
		Typography:
			Color: #6B2218
	For class: eng
		Box:
			Background: #E5DAF3
		Typography:
			Color: #432468
	For class: sci
		Box:
			Background: #D5ECD9
		Typography:
			Color: #1B4D2A
	For class: music
		Box:
			Background: #FBE8B8
		Typography:
			Color: #6B4A05
	For class: art
		Box:
			Background: #F9D8EA
		Typography:
			Color: #6B1D46
	For class: pe
		Box:
			Background: #FBDCC3
		Typography:
			Color: #6B3207
	For class: lab
		Box:
			Background: #CDEBEA
		Typography:
			Color: #12504D
	For class: tutor
		Box:
			Background: #E3E3E3
		Typography:
			Color: #333333
	For class: proj
		Box:
			Background: #E6EBC3
		Typography:
			Color: #475010
