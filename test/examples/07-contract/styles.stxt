# Estilos del ejemplo «contract»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Serif
			Size: 10
			Line height: 15
			Color: #1E1D2B
			Numbered: true
	Element: Heading 1
		Typography:
			Size: 15
			Line height: 20
			Weight: bold
			Align: center
			Color: #3F3D8F
			Transform: uppercase
			Letter spacing: 0.4
		Box:
			Margin: 0 0 4 0
	Element: Heading 2
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13
			Weight: bold
			Color: #3F3D8F
			Transform: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 16 0 6 0
			Padding: 0 0 3 0
			Border: 0 0 0.5 0
			Border color: #B9B8D9
	Element: Paragraph
		Typography:
			Align: justify
			Inline: markdown
		Box:
			Margin: 0 0 7 0
	Element: List
		Box:
			Padding: 0 0 0 20
	Element: Cell
		Box:
			Padding: 6 8
			Border: 0 0 0.5 0
			Border color: #CFCEE6
	Element: Fixed
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Color: #6C6B8A
	Element: Head cell
		Typography:
			Font: IBM Plex Sans
			Weight: bold
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #3F3D8F
	For class: total
		Typography:
			Weight: bold
		Box:
			Background: #ECECF7
			Border: 1.2 0 0 0
			Border color: #3F3D8F
	For class: party
		Box:
			Padding: 8 12
			Border: 0 0 0 2
			Border color: #3F3D8F
			Background: #F4F4FA
		Typography:
			Size: 9
			Line height: 13
	For class: sign
		Typography:
			Font: IBM Plex Sans
			Size: 8.5
		Box:
			Padding: 0 0 0 0
	For class: initials
		Box:
			Width: 46
			Height: 11
			Margin: 0 0 0 6
			Border: 0 0 0.5 0
			Border color: #6C6B8A
