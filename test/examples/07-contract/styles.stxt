# Estilos del ejemplo «contract»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.pdf):
	For element: Document
		Typography:
			Font: IBM Plex Serif
			Size: 10
			Line height: 15
			Color: #1E1D2B
			Numbered: true
	For element: Heading 1
		Typography:
			Size: 15
			Line height: 20
			Bold: true
			Align: center
			Color: #3F3D8F
			Transform: uppercase
			Letter spacing: 0.4
		Box:
			Margin: 0 0 4 0
	For element: Heading 2
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13
			Bold: true
			Color: #3F3D8F
			Transform: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 16 0 6 0
			Padding: 0 0 3 0
			Border: 0 0 0.5 0
			Border color: #B9B8D9
	For style: annex
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13
			Align: left
			Letter spacing: 0.8
			Number format: upper-roman
			Number label: Anexo {number} ·
		Box:
			Margin: 16 0 6 0
			Padding: 0 0 3 0
			Border: 0 0 0.5 0
			Border color: #B9B8D9
	For element: Paragraph
		Typography:
			Align: justify
			Inline: markdown
		Box:
			Margin: 0 0 7 0
	For element: List
		Box:
			Padding: 0 0 0 20
	For element: Cell
		Box:
			Padding: 6 8
			Border: 0 0 0.5 0
			Border color: #CFCEE6
	For element: Fixed
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Color: #6C6B8A
	For element: Head cell
		Typography:
			Font: IBM Plex Sans
			Bold: true
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #3F3D8F
	For style: total
		Typography:
			Bold: true
		Box:
			Background: #ECECF7
			Border: 1.2 0 0 0
			Border color: #3F3D8F
	For style: party
		Box:
			Padding: 8 12
			Border: 0 0 0 2
			Border color: #3F3D8F
			Background: #F4F4FA
		Typography:
			Size: 9
			Line height: 13
	For style: sign
		Typography:
			Font: IBM Plex Sans
			Size: 8.5
		Box:
			Padding: 0 0 0 0
	For style: initials
		Box:
			Width: 46
			Height: 11
			Margin: 0 0 0 6
			Border: 0 0 0.5 0
			Border color: #6C6B8A
