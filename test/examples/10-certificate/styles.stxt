# Estilos del ejemplo «certificate»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Serif
			Size: 11
			Line height: 16
			Color: #2A2D3A
			Align: center
	Element: Heading 1
		Typography:
			Size: 42
			Line height: 48
			Weight: bold
			Color: #14305E
		Box:
			Margin: 0 0 14 0
	Element: Heading 2
		Typography:
			Size: 21
			Line height: 27
			Weight: bold
			Color: #14305E
		Box:
			Margin: 6 0 8 0
	For class: school
		Typography:
			Font: IBM Plex Sans
			Size: 10
			Weight: bold
			Color: #A8782F
			Transform: uppercase
			Letter spacing: 3
		Box:
			Margin: 0 0 8 0
	For class: aside
		Typography:
			Style: italic
			Size: 13
			Color: #5E6070
	For class: name
		Typography:
			Size: 40
			Line height: 46
			Style: italic
			Color: #14305E
		Box:
			Width: 470
			Margin: 2 auto 8 auto
			Padding: 0 0 4 0
			Border: 0 0 1 0
			Border color: #A8782F
	For class: corner
		Box:
			Width: 14
			Height: 14
			Radius: 50%
			Background: #A8782F
	For class: line
		Box:
			Padding: 5 0 0 0
			Border: 0.75 0 0 0
			Border color: #2A2D3A
		Typography:
			Size: 10
			Line height: 14
	Element: Fixed
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Color: #7B7D8C
	For class: serial
		Typography:
			Color: #A8782F
			Transform: uppercase
			Letter spacing: 1.5
