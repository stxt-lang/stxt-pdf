# Estilos del ejemplo «resume»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13.5
			Color: #26323A
	Element: Heading 1
		Typography:
			Size: 30
			Line height: 34
			Weight: bold
			Color: #134E4A
	Element: Heading 2
		Typography:
			Size: 10
			Line height: 14
			Weight: bold
			Color: #1F7A7A
			Transform: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 20 0 9 0
			Padding: 0 0 4 0
			Border: 0 0 1 0
			Border color: #BFD9D7
	Element: Paragraph
		Box:
			Margin: 0 0 6 0
		Typography:
			Inline: markdown
	Element: List
		Box:
			Padding: 0 0 0 11
	For class: side
		Box:
			Background: #134E4A
			Padding: 34 22
		Typography:
			Color: #FFFFFF
	For class: side-title
		Typography:
			Size: 8
			Weight: bold
			Color: #8FD1CC
			Transform: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 20 0 8 0
	For class: track
		Box:
			Height: 3
			Radius: 1.5
			Background: #2F7370
			Margin: 3 0 9 0
	For class: fill
		Box:
			Height: 3
			Radius: 1.5
			Background: #FFFFFF
	For class: dates
		Typography:
			Weight: bold
			Color: #1F7A7A
	For class: role
		Typography:
			Weight: bold
			Size: 10
	For class: place
		Typography:
			Color: #6B7B85
		Box:
			Margin: 0 0 4 0
	For class: figure
		Typography:
			Size: 24
			Line height: 28
			Weight: bold
			Color: #1F7A7A
	For class: caption
		Typography:
			Size: 7.5
			Color: #6B7B85
