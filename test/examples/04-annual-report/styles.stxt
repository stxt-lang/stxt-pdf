# Estilos del ejemplo «annual report»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.pdf):
	For element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9.5
			Line height: 14.5
			Color: #1E2A3A
			Numbered: true
	For element: Heading 1
		Typography:
			Font: IBM Plex Serif
			Size: 26
			Line height: 30
			Bold: true
			Color: #12315A
		Box:
			Margin: 0 0 14 0
			Padding: 0 0 10 0
			Border: 0 0 1 0
			Border color: #C9D5E3
	For element: Heading 2
		Typography:
			Font: IBM Plex Serif
			Size: 13
			Line height: 17
			Bold: true
			Color: #12315A
		Box:
			Margin: 14 0 5 0
	For element: Paragraph
		Box:
			Margin: 0 0 8 0
		Typography:
			Align: justify
			Inline: markdown
	For element: List
		Box:
			Padding: 0 0 0 16
			Margin: 0 0 8 0
	For element: Cell
		Box:
			Padding: 6 8
			Border: 0 0 0.5 0
			Border color: #D5DEE9
	For element: Fixed
		Typography:
			Size: 7.5
			Color: #687788
	For style: section
		Break:
			Before: page
	For style: lead
		Typography:
			Font: IBM Plex Serif
			Italic: true
			Size: 12.5
			Line height: 18
			Color: #12315A
			Align: left
		Box:
			Margin: 0 0 14 0
	For style: kicker
		Typography:
			Size: 8
			Bold: true
			Color: #B16118
			Transform: uppercase
			Letter spacing: 1
		Box:
			Margin: 0 0 6 0
	For style: milestone
		Box:
			Padding: 10 0 0 0
			Border: 2 0 0 0
			Border color: #12315A
		Typography:
			Size: 8.5
			Line height: 12.5
	For style: bar
		Typography:
			Size: 7.5
			Bold: true
			Color: #FFFFFF
			Align: center
		Box:
			Background: #1B6E8C
	For style: tile
		Box:
			Background: #EEF3F8
			Padding: 14 14 12 14
			Border: 0 0 0 3
			Border color: #E07B1F
	For style: figure
		Typography:
			Font: IBM Plex Serif
			Size: 21
			Line height: 26
			Bold: true
			Color: #12315A
	For style: caption
		Typography:
			Size: 8
			Color: #5B6B7C
			Align: left
		Box:
			Margin: 4 0 12 0
	For element: Contents entry 1
		Box:
			Padding: 7 0
		Typography:
			Size: 10.5
			Line height: 15
	For element: Head cell
		Typography:
			Bold: true
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #12315A
	For style: total
		Typography:
			Bold: true
			Color: #12315A
		Box:
			Background: #EEF3F8
			Border: 1.5 0 0 0
			Border color: #12315A
	For style: quote
		Box:
			Padding: 12 16
			Margin: 6 0 12 0
			Border: 0 0 0 3
			Border color: #1B6E8C
			Background: #EEF6F8
		Typography:
			Font: IBM Plex Serif
			Italic: true
			Size: 11
			Line height: 16
			Color: #12315A
