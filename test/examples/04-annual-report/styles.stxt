# Estilos del ejemplo «annual report»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.pdf):
	Element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9.5
			Line height: 14.5
			Color: #1E2A3A
			Numbered: true
	Element: Heading 1
		Typography:
			Font: IBM Plex Serif
			Size: 26
			Line height: 30
			Weight: bold
			Color: #12315A
		Box:
			Margin: 0 0 14 0
			Padding: 0 0 10 0
			Border: 0 0 1 0
			Border color: #C9D5E3
	Element: Heading 2
		Typography:
			Font: IBM Plex Serif
			Size: 13
			Line height: 17
			Weight: bold
			Color: #12315A
		Box:
			Margin: 14 0 5 0
	Element: Paragraph
		Box:
			Margin: 0 0 8 0
		Typography:
			Align: justify
			Inline: markdown
	Element: List
		Box:
			Padding: 0 0 0 16
			Margin: 0 0 8 0
	Element: Cell
		Box:
			Padding: 6 8
			Border: 0 0 0.5 0
			Border color: #D5DEE9
	Element: Fixed
		Typography:
			Size: 7.5
			Color: #6B7B8C
	For class: section
		Break:
			Before: page
	For class: lead
		Typography:
			Font: IBM Plex Serif
			Style: italic
			Size: 12.5
			Line height: 18
			Color: #12315A
			Align: left
		Box:
			Margin: 0 0 14 0
	For class: kicker
		Typography:
			Size: 8
			Weight: bold
			Color: #E07B1F
			Transform: uppercase
			Letter spacing: 1
		Box:
			Margin: 0 0 6 0
	For class: milestone
		Box:
			Padding: 10 0 0 0
			Border: 2 0 0 0
			Border color: #12315A
		Typography:
			Size: 8.5
			Line height: 12.5
	For class: bar
		Typography:
			Size: 7.5
			Weight: bold
			Color: #FFFFFF
			Align: center
		Box:
			Background: #1B6E8C
	For class: tile
		Box:
			Background: #EEF3F8
			Padding: 14 14 12 14
			Border: 0 0 0 3
			Border color: #E07B1F
	For class: figure
		Typography:
			Font: IBM Plex Serif
			Size: 21
			Line height: 26
			Weight: bold
			Color: #12315A
	For class: caption
		Typography:
			Size: 8
			Color: #5B6B7C
			Align: left
		Box:
			Margin: 4 0 12 0
	Element: Contents entry 1
		Box:
			Padding: 7 0
		Typography:
			Size: 10.5
			Line height: 15
	Element: Head cell
		Typography:
			Weight: bold
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #12315A
	For class: total
		Typography:
			Weight: bold
			Color: #12315A
		Box:
			Background: #EEF3F8
			Border: 1.5 0 0 0
			Border color: #12315A
	For class: quote
		Box:
			Padding: 12 16
			Margin: 6 0 12 0
			Border: 0 0 0 3
			Border color: #1B6E8C
			Background: #EEF6F8
		Typography:
			Font: IBM Plex Serif
			Style: italic
			Size: 11
			Line height: 16
			Color: #12315A
