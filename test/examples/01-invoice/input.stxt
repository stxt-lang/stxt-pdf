					Typography:
						Size: 28
						Weight: bold
						Color: #3B2A1E
						Align: right
						Line height: 30
						Transform: uppercase
						Letter spacing: 2
				Text: Nº 2025-0147
					Typography:
						Size: 12
						Color: #B5651D
						Align: right
	Grid:
		Id: parties
		Columns: 1fr 1fr
		Gap: 18
