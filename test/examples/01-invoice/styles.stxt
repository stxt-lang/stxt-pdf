# Estilos del ejemplo «invoice»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13
			Color: #2B2420
	For class: label
		Typography:
			Size: 7
			Weight: bold
			Color: #B5651D
			Transform: uppercase
			Letter spacing: 0.6
		Box:
			Margin: 0 0 3 0
	For class: party
		Box:
			Padding: 12 14
			Radius: 0 6 6 0
			Border: 0 0 0 2.5
			Border color: #B5651D
			Background: #F8F3EA
	For class: strong
		Typography:
			Weight: bold
			Size: 10.5
	Element: Head cell
		Typography:
			Weight: bold
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #3B2A1E
			Padding: 7 8
	For class: total
		Typography:
			Weight: bold
			Size: 11
			Color: #3B2A1E
			Transform: uppercase
		Box:
			Background: #EFE4D2
			Border: 1.5 0 0 0
			Border color: #3B2A1E
	Element: Foot cell
		Typography:
			Align: right
	Element: Cell
		Box:
			Padding: 7 8
			Border: 0 0 0.5 0
			Border color: #DCCFB8
	Element: Fixed
		Typography:
			Size: 7.5
			Color: #7A6A5C
