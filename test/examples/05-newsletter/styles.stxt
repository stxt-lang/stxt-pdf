# Estilos del ejemplo «newsletter»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Serif
			Size: 9
			Line height: 13
			Color: #1C1A19
	Element: Heading 1
		Typography:
			Size: 27
			Line height: 30
			Weight: bold
		Box:
			Margin: 2 0 8 0
	Element: Heading 2
		Typography:
			Size: 10.5
			Line height: 13
			Weight: bold
			Color: #A4301F
		Box:
			Margin: 8 0 3 0
	Element: Paragraph
		Typography:
			Align: justify
		Box:
			Margin: 0 0 6 0
	Element: List
		Box:
			Padding: 0 0 0 12
			Margin: 0 0 6 0
	Element: Cell
		Box:
			Padding: 5 6
			Border: 0 0 0.5 0
			Border color: #CFC8C0
	Element: Fixed
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Color: #7A726B
	For class: kicker
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Weight: bold
			Color: #A4301F
			Transform: uppercase
			Letter spacing: 0.8
	For class: caption
		Typography:
			Font: IBM Plex Sans
			Size: 7.5
			Style: italic
			Color: #6B635C
		Box:
			Margin: 3 0 10 0
	For class: quote
		Typography:
			Size: 15
			Line height: 19
			Style: italic
			Color: #A4301F
			Align: center
		Box:
			Margin: 10 0 12 0
			Padding: 10 30
			Border: 1 0 1 0
			Border color: #A4301F
	Element: Head cell
		Typography:
			Font: IBM Plex Sans
			Weight: bold
			Size: 7.5
			Color: #FFFFFF
		Box:
			Background: #1C1A19
	Element: Even row cell
		Box:
			Background: #F1EDE8
	For class: ad
		Box:
			Padding: 8 10
			Border: 0.75
			Border color: #CFC8C0
		Typography:
			Size: 8.5
			Line height: 12
	For class: ad-title
		Typography:
			Font: IBM Plex Sans
			Weight: bold
			Size: 7
			Color: #A4301F
			Transform: uppercase
			Letter spacing: 0.6
		Box:
			Margin: 0 0 3 0
