	Block:
		Id: woods
		Break:
			Before: page
		Heading 1:
			Text: Maderas y acabados
		Paragraph: Trabajamos solo madera maciza de bosques gestionados de la comarca, secada al aire durante dos años como mínimo.
			Class: lead
		Table:
			Id: wood-table
			Columns: 70 1fr 90 1fr
			Box:
