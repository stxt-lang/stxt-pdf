					Cell: Aceite blanco, natural
		Heading 2:
			Text: Cómo trabajamos
			Box:
				Margin: 0 0 10 0
		Grid:
			Id: steps
			Columns: repeat(3, 1fr)
			Gap: 20
			Box:
				Margin: 0 0 26 0
			Area:
				Block:
					Text: 01
						Class: step-number
					Heading 3:
						Text: Visita y medidas
					Paragraph: Vamos a su casa, tomamos medidas y escuchamos qué necesita. La visita no tiene coste.
			Area:
				Block:
					Text: 02
						Class: step-number
					Heading 3:
						Text: Diseño y presupuesto
					Paragraph: En una semana le enviamos el diseño, la madera propuesta y un presupuesto cerrado.
			Area:
				Block:
					Text: 03
						Class: step-number
					Heading 3:
						Text: Fabricación
					Paragraph: Fabricamos en el taller y llevamos y montamos las piezas, sin que se tenga que ocupar de nada.
