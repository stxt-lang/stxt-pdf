# Estilos del ejemplo «manual»: las reglas reutilizables y la tipografía base. Se pasan junto a
# input.stxt al maquetar y valen menos que las reglas que el propio documento lleve en su Styles.
Styles (dev.stxt.boxes):
	Element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9.5
			Line height: 14.5
			Color: #1F2A30
	Element: Heading 1
		Typography:
			Size: 28
			Line height: 32
			Weight: bold
			Color: #134E4A
		Box:
			Margin: 0 0 4 0
	Element: Heading 2
		Typography:
			Size: 15
			Line height: 20
			Weight: bold
			Color: #1F7A7A
		Box:
			Margin: 20 0 8 0
			Padding: 0 0 4 0
			Border: 0 0 1 0
			Border color: #BFD9D7
	Element: Heading 3
		Typography:
			Size: 10.5
			Line height: 15
			Weight: bold
			Color: #134E4A
		Box:
			Margin: 12 0 4 0
	Element: Paragraph
		Typography:
			Inline: markdown
		Box:
			Margin: 0 0 7 0
	Element: List
		Box:
			Padding: 0 0 0 18
			Margin: 0 0 8 0
	Element: List item
		Box:
			Margin: 0 0 3 0
	Element: Cell
		Box:
			Padding: 5 8
			Border: 0 0 0.5 0
			Border color: #CFE0DF
	Element: Fixed
		Typography:
			Size: 7.5
			Color: #5E7479
	For class: lead
		Typography:
			Size: 12
			Line height: 18
			Color: #3C5359
		Box:
			Margin: 0 0 16 0
	For class: banner
		Box:
			Background: #134E4A
			Padding: 22 26
		Typography:
			Color: #FFFFFF
	For class: notice
		Box:
			Padding: 10 14
			Margin: 8 0 12 0
			Radius: 0 4 4 0
			Border: 0 0 0 3
			Border color: #E9A23B
			Background: #FDF4E1
	For class: tip
		Box:
			Padding: 10 14
			Margin: 8 0 12 0
			Radius: 0 4 4 0
			Border: 0 0 0 3
			Border color: #1F7A7A
			Background: #E7F3F2
	For class: label
		Typography:
			Size: 7.5
			Weight: bold
			Color: #8A5A0B
			Transform: uppercase
			Letter spacing: 0.6
		Box:
			Margin: 0 0 2 0
	For class: badge
		Typography:
			Size: 8
			Weight: bold
			Color: #FFFFFF
			Align: center
			Line height: 16
		Box:
			Width: 16
			Height: 16
			Radius: 50%
			Background: #1F7A7A
	For class: code
		Typography:
			Font: IBM Plex Mono
			Size: 8.5
			Line height: 13
			Color: #D6E4E6
		Box:
			Background: #1A1D23
			Padding: 10 14
			Margin: 4 0 10 0
	Element: Head cell
		Typography:
			Weight: bold
			Size: 8
			Color: #FFFFFF
		Box:
			Background: #134E4A
	For class: mono
		Typography:
			Font: IBM Plex Mono
			Size: 8.5
			Weight: bold
