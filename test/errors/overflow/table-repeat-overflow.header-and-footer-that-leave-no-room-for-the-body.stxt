Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Table:
			Column sizes: *
			Header rows:
				Row:
					Cell:
						Box:
							Height: 600
			Body:
				Row:
					Cell: a
			Footer rows:
				Row:
					Cell:
						Box:
							Height: 300
