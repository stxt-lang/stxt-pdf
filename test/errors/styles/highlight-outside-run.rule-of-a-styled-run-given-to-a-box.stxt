# Case: A For style rule with Highlight, which a styled run takes, is given to a Text with Style
# Code: HIGHLIGHT_OUTSIDE_RUN
# Line: 18
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
		For style: mark
			Typography:
				Highlight: #FFE680
	Section:
		Text: Vence el [viernes]{mark}
		Text: Vence el viernes
			Style: mark
