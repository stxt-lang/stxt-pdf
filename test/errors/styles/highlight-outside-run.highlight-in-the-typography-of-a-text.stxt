# Case: A Text declares Highlight in its Typography, and only a styled run is highlighted
# Code: HIGHLIGHT_OUTSIDE_RUN
# Line: 19
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Text: Vence el viernes
			Typography:
				Highlight: #FFE680
