# Case: A Text declares Position in its Typography, and only a styled run can be a superscript
# Code: POSITION_OUTSIDE_RUN
# Line: 19
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Text: m2
			Typography:
				Position: superscript
