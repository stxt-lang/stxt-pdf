# Case: Regla Head cell que aplica Break a una Cell
# Code: STYLE_NOT_ALLOWED
# Line: 16
Document (dev.stxt.boxes):
	Language: es
	Title: Prueba
	Media:
		Width: 595
		Height: 842
	Styles:
		Element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
		Element: Head cell
			Break:
				After: avoid
	Section:
