# Case: After in a Text inside a rotated Block, which does not break
# Code: BREAK_IN_UNBREAKABLE
# Line: 20
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
