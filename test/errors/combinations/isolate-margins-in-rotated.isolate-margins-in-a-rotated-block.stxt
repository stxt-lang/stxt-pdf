# Case: Isolate margins in a rotated Block, which already stops margin merging
# Code: ISOLATE_MARGINS_IN_ROTATED
# Line: 18
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Block:
			Rotate: 90
			Isolate margins: true
			Text: Lateral
