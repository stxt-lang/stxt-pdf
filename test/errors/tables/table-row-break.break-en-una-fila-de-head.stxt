# Case: Break en una fila de Head
# Code: TABLE_ROW_BREAK
# Line: 20
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
