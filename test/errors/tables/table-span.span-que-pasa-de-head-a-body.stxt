# Case: Span que pasa de Head a Body
# Code: TABLE_SPAN
# Line: 21
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Table:
			Column sizes: * *
			Head:
				Row:
					Cell: a
						Span: 2 2
			Body:
				Row:
					Cell: b
					Cell: c
