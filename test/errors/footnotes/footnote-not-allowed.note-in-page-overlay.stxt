# Case: A Footnote inside a Page overlay
# Code: FOOTNOTE_NOT_ALLOWED
# Line: 22
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Page overlay:
			Offset: auto 0 -15 0
			Block:
				Text: Pie de página
				Footnote:
					Id: fuente
					Paragraph: La fuente.
		Paragraph: Una afirmación[^fuente].
