# Case: A Footnote whose Markdown has a heading
# Code: FOOTNOTE_CONTENT
# Line: 23
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Paragraph: Una afirmación[^fuente].
		Footnote:
			Id: fuente
			Markdown:
				Content >>
					# La fuente

					Un párrafo.
