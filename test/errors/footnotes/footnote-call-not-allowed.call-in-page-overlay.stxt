# Case: A footnote call in a Page overlay
# Code: FOOTNOTE_CALL_NOT_ALLOWED
# Line: 20
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Page overlay:
			Offset: auto 0 -15 0
			Text: Pie[^fuente] de página
		Paragraph: Una afirmación.
		Footnote:
			Id: fuente
			Paragraph: La fuente.
