# Case: A footnote call whose Footnote is in another section
# Code: FOOTNOTE_UNKNOWN
# Line: 18
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
				Markup: markdown
	Section:
		Paragraph: Una afirmación[^fuente] con la nota en otra sección.
	Section:
		Paragraph: Otra sección.
		Footnote:
			Id: fuente
			Paragraph: La fuente.
