# Pagination (reference/common/breaks.md). Page area of 260 × 160 from (20, 20).
#
# Page 1: intro takes 0..100. title would go at 110..130 and text at 140, where only one of its
#   6 lines fits: splitting it leaves orphans (quality 2) and breaking before text violates the avoid of
#   title (quality 1). Breaking before title violates nothing (quality 3): it wins.
# Page 2: title at the top, without its top margin (unforced break), and text whole at 30.
#   grid has Before: page in its Break.
# Page 3: grid rows at 0..50, 60..110 and 120..170; the first two fit.
# Page 4: the third row, without the gap that separated it from the second, and end.
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Page overlay:
			Id: header
			Offset: -15 0 auto 0
			Box:
				Height: 10
			Typography:
				Size: 8
			Text: Cabecera
		Page overlay:
			Id: footer
			Offset: auto 0 -15 0
			Box:
				Height: 10
			Typography:
				Size: 8
				Align: right
			Text: Pie
		Block:
			Id: intro
			Box:
				Height: 100
		Text: Título
			Id: title
			Box:
				Height: 20
				Margin: 10 0 10 0
			Break:
				Keep with next: true
		Text: aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa
			Id: text
			Box:
				Width: 30
		Grid:
			Id: grid
			Break:
				Before: page
			Column sizes: * *
			Gap: 10
			Area:
				Block:
					Id: g1
					Box:
						Height: 50
			Area:
				Block:
					Id: g2
					Box:
						Height: 50
			Area:
				Block:
					Id: g3
					Box:
						Height: 50
			Area:
				Block:
					Id: g4
					Box:
						Height: 50
			Area:
				Block:
					Id: g5
					Box:
						Height: 50
		Block:
			Id: end
			Box:
				Height: 10
