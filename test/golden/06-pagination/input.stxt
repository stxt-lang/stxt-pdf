# Paginación (reference/common/breaks.md). Área útil de 260 × 160 desde (20, 20).
#
# Página 1: intro ocupa 0..100. title iría en 110..130 y text en 140, donde solo cabe una de sus
#   6 líneas: partirlo deja huérfanas (calidad 2) y cortar antes de text incumple el avoid de
#   title (calidad 1). Cortar antes de title no incumple nada (calidad 3): gana.
# Página 2: title arriba, sin su margen superior (corte no forzado), y text entero en 30.
#   grid tiene Before: page en su Break.
# Página 3: filas de grid en 0..50, 60..110 y 120..170; caben las dos primeras.
# Página 4: la tercera fila, sin el hueco que la separaba de la segunda, y end.
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Page overlay:
			Id: header
			Offset: -15 0 auto 0
			Box:
				Height: 10
			Typography:
				Size: 8
			Text: Cabecera
		Page overlay:
			Id: footer
			Offset: auto 0 -15 0
			Box:
				Height: 10
			Typography:
				Size: 8
				Align: right
			Text: Pie
		Block:
			Id: intro
			Box:
				Height: 100
		Text: Título
			Id: title
			Box:
				Height: 20
				Margin: 10 0 10 0
			Break:
				Keep with next: true
		Text: aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa
			Id: text
			Box:
				Width: 30
		Grid:
			Id: grid
			Break:
				Before: page
			Column sizes: * *
			Gap: 10
			Area:
				Block:
					Id: g1
					Box:
						Height: 50
			Area:
				Block:
					Id: g2
					Box:
						Height: 50
			Area:
				Block:
					Id: g3
					Box:
						Height: 50
			Area:
				Block:
					Id: g4
					Box:
						Height: 50
			Area:
				Block:
					Id: g5
					Box:
						Height: 50
		Block:
			Id: end
			Box:
				Height: 10
