# Positioning (reference/components/frame-and-overlays.md): Frame, Overlay in its reference container and
# Page overlay in the page margin.
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 595
		Height: 842
		Margin: 40
	Section:
		Page overlay:
			Id: header
			Offset: -30 0 auto 0
			Box:
				Height: 20
		Page overlay:
			Id: footer
			Offset: auto 0 -30 0
			Box:
				Height: 20
		Block:
			Id: title
			Box:
				Height: 24
				Margin: 0 0 16 0
		Frame:
			Id: card
			Offset: 5 auto auto 10
			Box:
				Height: 100
				Padding: 10
				Border: 2
			Overlay:
				Id: badge
				Offset: 0 0 auto auto
				Box:
					Width: 50
					Height: 20
		Block:
			Id: next
			Box:
				Height: 30
		Overlay:
			Id: stamp
			Offset: 0 0 auto auto
			Box:
				Width: 80
				Height: 30
