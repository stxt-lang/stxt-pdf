# Pages where a Page overlay appears (reference/components/frame-and-overlays.md). Page area of 260 × 160 from (20, 20).
#
# Four pages, one per block of 60 (Break After: page). The Page overlay elements take up no space: the flow
# is the same with or without them. Pages counts the pages from 1, in document order.
#   cover (first):     x = 20, y = 20, only on page 1.
#   head (not-first):  Offset 0 0 auto 0: x = 20, y = 20, 260 × 12; pages 2, 3 and 4.
#   foot (all):        Offset auto 0 0 0: at the bottom, y = 20 + 160 − 10 = 170; all four.
#   odd (odd):         Offset 30 auto auto 0: y = 20 + 30 = 50; pages 1 and 3.
#   even (even):       Offset 60 0 auto auto, 20 wide: x = 20 + 260 − 20 = 260, y = 80; pages 2 and 4.
#   end (last):        Offset auto 0 0 auto, 30 × 10: x = 250, y = 170; only page 4 (the last one).
#   inner (first):     inside head, which does not appear on page 1: it does not appear either (not-first and first
#                      do not coincide on any page).
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
	Section:
		Block:
			Id: c1
			Break:
				After: page
			Box:
				Height: 60
		Block:
			Id: c2
			Break:
				After: page
			Box:
				Height: 60
		Block:
			Id: c3
			Break:
				After: page
			Box:
				Height: 60
		Block:
			Id: c4
			Box:
				Height: 60
		Page overlay:
			Id: cover
			Pages: first
			Offset: 0 auto auto 0
			Box:
				Width: 100
				Height: 40
		Page overlay:
			Id: head
			Pages: not-first
			Offset: 0 0 auto 0
			Box:
				Height: 12
			Page overlay:
				Id: inner
				Pages: first
				Offset: 0 auto auto 0
				Box:
					Width: 10
					Height: 10
		Page overlay:
			Id: foot
			Offset: auto 0 0 0
			Box:
				Height: 10
		Page overlay:
			Id: odd
			Pages: odd
			Offset: 30 auto auto 0
			Box:
				Width: 20
				Height: 8
		Page overlay:
			Id: even
			Pages: even
			Offset: 60 0 auto auto
			Box:
				Width: 20
				Height: 8
		Page overlay:
			Id: end
			Pages: last
			Offset: auto 0 0 auto
			Box:
				Width: 30
				Height: 10
