# Tables (reference/components/table.md). Page area of 260 × 160 from (20, 20).
#
# Columns: 100 and * with a gap of 10: 260 − 100 − 10 = 150, from x = 130. Each cell has
# Padding 2 4: a line measures 12 + 4 = 16, and the header, with its bottom border, 17. The footer
# (16) spans both columns. b8 has two lines (92 wide: 18 characters fit), 28, and
# stretches b8v. The header and the footer (33) repeat on every page.
# Page 1: intro (40) leaves 120 to the table and 87 to the body: b1...b5 (80).
# Page 2: 127 for the body: b6...b12 (16 × 6 + 28 = 124); b13 no longer fits.
# Page 3: b13 and b14, the footer after them, and end.
Document (dev.stxt.pdf):
	Language: es
	Title: Prueba
	Page:
		Width: 300
		Height: 200
		Margin: 20
	Styles:
		For element: Document
			Typography:
				Font: IBM Plex Sans
				Size: 10
		For element: Cell
			Box:
				Padding: 2 4
		For style: rule
			Box:
				Border: 0 0 1 0
	Section:
		Block:
			Id: intro
			Box:
				Height: 40
		Table:
			Id: t
			Column sizes: 100 *
			Gap: 0 10
			Header rows:
				Row:
					Typography:
						Bold: true
					Cell: Concepto
						Id: h1
						Style: rule
					Cell: Valor
						Style: rule
			Body:
				Row:
					Cell: Fila 1
						Id: b1
					Cell: 1
				Row:
					Cell: Fila 2
						Id: b2
					Cell: 2
				Row:
					Cell: Fila 3
						Id: b3
					Cell: 3
				Row:
					Cell: Fila 4
						Id: b4
					Cell: 4
				Row:
					Cell: Fila 5
						Id: b5
					Cell: 5
				Row:
					Cell: Fila 6
						Id: b6
					Cell: 6
				Row:
					Cell: Fila 7
						Id: b7
					Cell: 7
				Row:
					Cell: aaaa bbbb cccc dddd
						Id: b8
					Cell: 8
						Id: b8v
				Row:
					Cell: Fila 9
						Id: b9
					Cell: 9
				Row:
					Cell: Fila 10
						Id: b10
					Cell: 10
				Row:
					Cell: Fila 11
						Id: b11
					Cell: 11
				Row:
					Cell: Fila 12
						Id: b12
					Cell: 12
				Row:
					Cell: Fila 13
						Id: b13
					Cell: 13
				Row:
					Cell: Fila 14
						Id: b14
					Cell: 14
			Footer rows:
				Row:
					Typography:
						Bold: true
					Cell: Total
						Id: f
						Span: 1 2
		Paragraph: Fin
			Id: end
