<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stxt</groupId>
    <artifactId>stxt-pdf</artifactId>
    <version>0.8.0</version>
    <packaging>jar</packaging>

    <!-- Metadatos exigidos por Maven Central (name, description, url, licencia, desarrolladores y scm),
         los mismos que los de dev.stxt:stxt-core. -->
    <name>STXT PDF</name>
    <description>Layout engine and PDF generator for STXT documents: tagged PDF/UA output with embedded fonts.</description>
    <url>https://github.com/stxt-lang/stxt-pdf</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Joan Costa Mombiela</name>
            <email>joan.costa.mombiela@gmail.com</email>
            <url>https://github.com/stxt-lang</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/stxt-lang/stxt-pdf.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/stxt-lang/stxt-pdf.git</developerConnection>
        <url>https://github.com/stxt-lang/stxt-pdf</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/stxt-lang/stxt-pdf/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Build reproducible: fija las fechas dentro del jar. Se actualiza en cada release. -->
        <project.build.outputTimestamp>2026-10-31T18:00:00Z</project.build.outputTimestamp>
        <junit.version>5.10.2</junit.version>
        <commonmark.version>0.30.1</commonmark.version>
        <excludedGroups>perf</excludedGroups>
    </properties>

    <dependencies>
        <!-- Parser y validador oficial de STXT. Lo usa stxt.DocumentReader, y el motor trabaja con sus nodos.
             Comprueba la última versión en https://central.sonatype.com/artifact/dev.stxt/stxt-core
             Al cambiarla, vuelve a comprobar que el schema compartido (SchemaProviderMemory, SchemaValidator) se
             lee sin escribir: ver tree/DocumentSchema, y ConcurrentConversionTest. 1.0.3 es la versión revisada. -->
        <dependency>
            <groupId>dev.stxt</groupId>
            <artifactId>stxt-core</artifactId>
            <version>1.0.3</version>
        </dependency>

        <!-- Salida PDF (paint.PdfCanvas) y métricas reales de fuentes (layout.inline.PdfMetrics). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- Elemento Markdown (tree.MarkdownBuilder): CommonMark con las tablas y el tachado de GFM
             y el subrayado de la extensión ins (++texto++). -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-ins</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- Imágenes SVG (resources.ImageFile, paint.PdfCanvas): JSVG lee y dibuja el SVG en un Graphics2D y
             pdfbox-graphics2d convierte lo dibujado en rutas, rellenos y texto del PDF (referencia/componentes/image.md). -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>de.rototor.pdfbox</groupId>
            <artifactId>graphics2d</artifactId>
            <version>3.0.5</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Validador de PDF/UA (accesibilidad) de los PDF de los ejemplos: solo en los tests. -->
        <dependency>
            <groupId>org.verapdf</groupId>
            <artifactId>validation-model</artifactId>
            <version>1.28.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Las medidas de rendimiento (@Tag("perf")) no van en la suite normal:
                         mvn test -Dgroups=perf -DexcludedGroups=none -Dtest=LongTextTest -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- Cobertura de los tests: mvn test deja el informe en target/site/jacoco/index.html.
                 Solo el informe, sin umbral. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Empaquetado. La versión va fijada para que el build no dependa de la que traiga por defecto cada
                 versión de Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Nombre de módulo estable para consumidores con JPMS, mientras no haya
                                 module-info.java. El de stxt-core es dev.stxt. -->
                            <Automatic-Module-Name>dev.stxt.pdf</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Central exige el jar de fuentes junto al binario. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central exige también el jar de javadoc. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Firma GPG solo al publicar: `mvn -Prelease ...`. Fuera de este perfil el build diario no necesita
             clave ni passphrase. Es el mismo perfil que el de stxt-core. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sube el bundle firmado al Central Portal (fase deploy). `extensions` es imprescindible:
                         registra el participante de ciclo de vida que desactiva el maven-deploy-plugin, que si no
                         intentaría desplegar además en un <distributionManagement> que no existe. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- id del <server> de ~/.m2/settings.xml que lleva el user token del Portal (no la
                                 contraseña de la cuenta). -->
                            <publishingServerId>central</publishingServerId>
                            <!-- El deploy deja el despliegue validado y *pendiente* en el Portal, para revisarlo y
                                 confirmarlo a mano desde la web. Una vez publicado en Central no se puede retirar
                                 ni sustituir. -->
                            <autoPublish>false</autoPublish>
                            <!-- Espera a que el Portal valide el bundle, para que un error de validación falle el
                                 build en vez de quedarse escondido en la web. -->
                            <waitUntil>VALIDATED</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Pruebas de mutación: una pasada puntual sobre layout y fragment, no en la CI.
             mvn -Ppit test-compile org.pitest:pitest-maven:mutationCoverage
             El informe queda en target/pit-reports/index.html. -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>dev.stxt.pdf.layout.*</param>
                                <param>dev.stxt.pdf.fragment.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>dev.stxt.pdf.*</param>
                            </targetTests>
                            <!-- Los que escriben en carpetas compartidas de target/ (los minions corren a la vez) o
                                 arrancan otra JVM. -->
                            <excludedTestClasses>
                                <param>dev.stxt.pdf.golden.GoldenTest</param>
                                <param>dev.stxt.pdf.examples.*</param>
                                <param>dev.stxt.pdf.paint.PdfCanvasTest</param>
                                <param>dev.stxt.pdf.concurrency.*</param>
                            </excludedTestClasses>
                            <excludedGroups>
                                <param>perf</param>
                            </excludedGroups>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>CSV</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
