<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stxt</groupId>
    <artifactId>stxt-pdf</artifactId>
    <version>0.8.0</version>
    <packaging>jar</packaging>

    <!-- Metadata required by Maven Central (name, description, url, license, developers and scm),
         the same as those of dev.stxt:stxt-core. -->
    <name>STXT PDF</name>
    <description>Layout engine and PDF generator for STXT documents: tagged PDF/UA output with embedded fonts.</description>
    <url>https://github.com/stxt-lang/stxt-pdf</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Joan Costa Mombiela</name>
            <email>joan.costa.mombiela@gmail.com</email>
            <url>https://github.com/stxt-lang</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/stxt-lang/stxt-pdf.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/stxt-lang/stxt-pdf.git</developerConnection>
        <url>https://github.com/stxt-lang/stxt-pdf</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/stxt-lang/stxt-pdf/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible build: fixes the dates inside the jar. Updated on each release. -->
        <project.build.outputTimestamp>2026-10-31T18:00:00Z</project.build.outputTimestamp>
        <junit.version>5.10.2</junit.version>
        <commonmark.version>0.30.1</commonmark.version>
        <excludedGroups>perf</excludedGroups>
    </properties>

    <dependencies>
        <!-- Official STXT parser and validator. Used by stxt.DocumentReader, and the engine works with its nodes.
             Latest version at https://central.sonatype.com/artifact/dev.stxt/stxt-core
             When it changes, check again that the shared schema (SchemaProviderMemory, SchemaValidator) is
             read without writing: see tree/DocumentSchema, and ConcurrentConversionTest. 1.0.3 is the reviewed version. -->
        <dependency>
            <groupId>dev.stxt</groupId>
            <artifactId>stxt-core</artifactId>
            <version>1.0.3</version>
        </dependency>

        <!-- PDF output (paint.PdfCanvas) and real font metrics (layout.inline.PdfMetrics). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- Markdown element (tree.MarkdownBuilder): CommonMark with the GFM tables and strikethrough
             and the underline of the ins extension (++text++). -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-ins</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- SVG images (resources.ImageFile, paint.PdfCanvas): JSVG reads and draws the SVG on a Graphics2D and
             pdfbox-graphics2d turns what is drawn into PDF paths, fills and text (reference/components/image.md). -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>de.rototor.pdfbox</groupId>
            <artifactId>graphics2d</artifactId>
            <version>3.0.5</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- PDF/UA (accessibility) validator for the PDFs of the examples: tests only. -->
        <dependency>
            <groupId>org.verapdf</groupId>
            <artifactId>validation-model</artifactId>
            <version>1.28.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- The performance measurements (@Tag("perf")) are not part of the normal suite:
                         mvn test -Dgroups=perf -DexcludedGroups=none -Dtest=LongTextTest -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- Test coverage: mvn test leaves the report in target/site/jacoco/index.html.
                 Report only, no threshold. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Packaging. The version is pinned so that the build does not depend on the default one of each
                 Maven version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Stable module name for JPMS consumers, while there is no
                                 module-info.java. The one of stxt-core is dev.stxt. -->
                            <Automatic-Module-Name>dev.stxt.pdf</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Central requires the sources jar alongside the binary. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central also requires the javadoc jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GPG signing only when publishing: `mvn -Prelease ...`. Outside this profile the daily build needs
             neither key nor passphrase. It is the same profile as the one of stxt-core. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Uploads the signed bundle to the Central Portal (deploy phase). `extensions` is essential:
                         it registers the lifecycle participant that disables the maven-deploy-plugin, which otherwise
                         would also try to deploy to a <distributionManagement> that does not exist. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- id of the <server> in ~/.m2/settings.xml that holds the Portal user token (not the
                                 account password). -->
                            <publishingServerId>central</publishingServerId>
                            <!-- The deploy leaves the deployment validated and *pending* in the Portal, to review
                                 and confirm it by hand from the website. Once published on Central it cannot be
                                 withdrawn or replaced. -->
                            <autoPublish>false</autoPublish>
                            <!-- Waits for the Portal to validate the bundle, so that a validation error fails the
                                 build instead of staying hidden on the website. -->
                            <waitUntil>VALIDATED</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing: an occasional run over layout and fragment, not in CI.
             mvn -Ppit test-compile org.pitest:pitest-maven:mutationCoverage
             The report is left in target/pit-reports/index.html. -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>dev.stxt.pdf.layout.*</param>
                                <param>dev.stxt.pdf.fragment.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>dev.stxt.pdf.*</param>
                            </targetTests>
                            <!-- Those that write to shared folders in target/ (the minions run at the same time) or
                                 start another JVM. -->
                            <excludedTestClasses>
                                <param>dev.stxt.pdf.golden.GoldenTest</param>
                                <param>dev.stxt.pdf.examples.*</param>
                                <param>dev.stxt.pdf.paint.PdfCanvasTest</param>
                                <param>dev.stxt.pdf.concurrency.*</param>
                            </excludedTestClasses>
                            <excludedGroups>
                                <param>perf</param>
                            </excludedGroups>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>CSV</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
