# Grid (ESPECIFICACION.md §5.8): áreas con nombre, pistas fijas y en fracción, y colocación
# automática con filas implícitas.
Document (dev.stxt.boxes):
	Media:
		Type: continuous
		Width: 595
		Margin: 40
	Font: IBM Plex Sans
	Font size: 10
	Grid:
		Id: page
		Columns: 150 1fr
		Gap: 10 20
		Areas >>
			head head
			side main
			foot foot
		Cell: head
			Block:
				Id: head
				Height: 30
		Cell: side
			Text: Resumen
				Id: side
		Cell: main
			Block:
				Id: main
				Height: 60
		Cell: foot
			Block:
				Id: foot
				Height: 20
	Grid:
		Id: cards
		Margin: 20 0 0 0
		Columns: repeat(3, 1fr)
		Gap: 10
		Cell:
			Block:
				Id: c1
				Height: 40
		Cell:
			Block:
				Id: c2
				Height: 50
		Cell:
			Block:
				Id: c3
				Height: 30
		Cell:
			Block:
				Id: c4
				Height: 20
