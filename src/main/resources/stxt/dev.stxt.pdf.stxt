			Child: Lines
				Max: 1
			Child: Item
			Child: Overlay
			Child: Page overlay
	Node: Grid
		Type: GROUP
		Description: Contenedor grid: coloca sus ítems (Area) en una rejilla de filas y columnas.
		Children:
			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
