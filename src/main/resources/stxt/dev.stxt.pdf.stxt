			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Break
				Max: 1
			Child: Isolate
				Max: 1
			Child: Block
			Child: Flex
			Child: Grid
			Child: Text
			Child: Paragraph
			Child: Heading 1
			Child: Heading 2
			Child: Heading 3
			Child: Heading 4
			Child: Heading 5
			Child: Heading 6
			Child: List
			Child: Markdown
			Child: Contents
			Child: Image
			Child: Table
			Child: Multicol
			Child: Relative
			Child: Absolute
			Child: Fixed
	Node: Flex
		Type: GROUP
		Description: Contenedor flex: coloca sus ítems (Item) a lo largo de un eje.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
