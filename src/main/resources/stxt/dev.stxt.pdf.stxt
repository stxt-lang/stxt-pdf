				Max: 1
			Child: Break
				Max: 1
			Child: Content
				Max: 1
	Node: Paragraph
		Type: INLINE
		Description: Párrafo: un Text con significado (etiqueta P en el PDF). Un solo párrafo, sin líneas en blanco en Content.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
