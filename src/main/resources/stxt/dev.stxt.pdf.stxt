			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Break
				Max: 1
			Child: Contain margins
				Max: 1
			Child: Rotate
				Max: 1
			Child: Block
			Child: Flex
			Child: Grid
			Child: Text
			Child: Paragraph
			Child: Heading 1
