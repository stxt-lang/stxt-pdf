		Type: GROUP
		Description: Ítem de una List: un bloque con uno o varios elementos, sin encabezados. Su marcador se alinea con su primera línea.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Link
				Max: 1
			Child: Box
