			Child: Heading 5
			Child: Heading 6
			Child: List
			Child: Markdown
			Child: Table of contents
			Child: Image
			Child: Table
			Child: Columns
			Child: Frame
			Child: Overlay
			Child: Page overlay
	Node: Flex
		Type: GROUP
		Description: Contenedor flex: coloca sus ítems (Item) uno tras otro, en horizontal o en vertical (Direction), y reparte el espacio que sobra.
		Children:
			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Break
				Max: 1
			Child: Direction
