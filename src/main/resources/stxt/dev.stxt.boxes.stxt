				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Text
				Min: 1
	Node: Heading 3
		Type: GROUP
		Description: Encabezado de nivel 3 (ver Heading 1).
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Text
				Min: 1
	Node: Heading 4
		Type: GROUP
		Description: Encabezado de nivel 4 (ver Heading 1).
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Text
				Min: 1
	Node: Heading 5
		Type: GROUP
		Description: Encabezado de nivel 5 (ver Heading 1).
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Text
				Min: 1
	Node: Heading 6
		Type: GROUP
		Description: Encabezado de nivel 6 (ver Heading 1).
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Text
				Min: 1
	Node: Relative
		Type: GROUP
		Description: Caja de bloque que se desplaza con Offset sin mover a sus hermanos. Es el containing block de sus descendientes Absolute.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Break
				Max: 1
			Child: Isolate
				Max: 1
			Child: Offset
				Max: 1
			Child: Layer
				Max: 1
			Child: Block
			Child: Flex
			Child: Grid
			Child: Text
			Child: Paragraph
			Child: Heading 1
			Child: Heading 2
			Child: Heading 3
			Child: Heading 4
			Child: Heading 5
			Child: Heading 6
			Child: Relative
			Child: Absolute
			Child: Fixed
	Node: Absolute
		Type: GROUP
		Description: Caja de bloque fuera de flujo, colocada con Offset en su containing block.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Offset
				Max: 1
			Child: Layer
				Max: 1
			Child: Block
			Child: Flex
			Child: Grid
			Child: Text
			Child: Paragraph
			Child: Heading 1
			Child: Heading 2
			Child: Heading 3
			Child: Heading 4
			Child: Heading 5
			Child: Heading 6
			Child: Relative
			Child: Absolute
			Child: Fixed
	Node: Fixed
		Type: GROUP
		Description: Caja de bloque fuera de flujo, colocada con Offset en el área útil. En modo paginado se repite en cada página.
		Children:
			Child: Id
				Max: 1
			Child: Class
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Offset
				Max: 1
			Child: Layer
				Max: 1
			Child: Block
			Child: Flex
			Child: Grid
			Child: Text
			Child: Paragraph
			Child: Heading 1
			Child: Heading 2
			Child: Heading 3
			Child: Heading 4
			Child: Heading 5
			Child: Heading 6
			Child: Relative
			Child: Absolute
			Child: Fixed
	Node: Item
		Type: GROUP
		Description: Ítem de un Flex: cómo crece, encoge y se alinea. Contiene exactamente un elemento.
		Children:
			Child: Grow
				Max: 1
			Child: Shrink
				Max: 1
			Child: Basis
				Max: 1
			Child: Cross axis
				Max: 1
			Child: Layer
				Max: 1
			Child: Block
				Max: 1
			Child: Flex
				Max: 1
			Child: Grid
				Max: 1
			Child: Text
				Max: 1
			Child: Paragraph
				Max: 1
